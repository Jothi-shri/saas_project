# Copy to .env and fill in real values. Never commit .env with real secrets.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_HOURS=0.25
JWT_REFRESH_TTL_HOURS=168
# Local development (Vite dev server). Keep these for local work.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=SaaS Platform <no-reply@example.com>
EMAIL_FROM_NAME=SaaS Platform
# Production (Render backend + Netlify frontend) — set these as environment
# variables on Render, do NOT commit real secrets:
# CORS_ORIGINS=https://saasproject-app.netlify.app
# FRONTEND_URL=https://saasproject-app.netlify.app
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
