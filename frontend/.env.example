# Copy to .env (.env.local / .env.production) and set the deployed backend URL.
# Leave empty for local dev (Vite proxy handles /api + /system). Never put
# backend secrets (DATABASE_URL, JWT_SECRET, RESEND_API_KEY) in frontend env.
VITE_API_URL=
# Production example (live Render backend used by the Netlify deployment):
# VITE_API_URL=https://saas-project-83ur.onrender.com
# Netlify also sets VITE_API_URL=https://saas-project-83ur.onrender.com
# via netlify.toml [build.environment] (dashboard env vars override it).
